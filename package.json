{
  "name": "drumkiller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DRUMKILLER \u2014 a finger-drumming rhythm game for MIDI pads (4x4 pads, Yamaha FGDP-30/50) that runs in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo-song": "node scripts/make-demo-song.mjs",
    "e2e": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
